<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>scrept ai</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b0f19;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        /* کادر اصلی چت با نسبت ۱۶:۹ یا متناسب با صفحه */
        .chat-container {
            width: 90%;
            max-width: 900px;
            height: 80vh;
            background: #111827;
            border: 1px solid #1f293d;
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            overflow: hidden;
        }

        /* هدر */
        .chat-header {
            padding: 18px 24px;
            background: #1e293b;
            border-bottom: 1px solid #334155;
            font-size: 20px;
            font-weight: bold;
            color: #38bdf8;
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
        }

        /* بخش پیام‌ها */
        .chat-messages {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .message {
            max-width: 70%;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 15px;
            line-height: 1.5;
            word-wrap: break-word;
        }

        .user-message {
            align-self: flex-start;
            background-color: #2563eb;
            color: #ffffff;
            border-bottom-right-radius: 2px;
        }

        .bot-message {
            align-self: flex-end;
            background-color: #1e293b;
            color: #e2e8f0;
            border: 1px solid #334155;
            border-bottom-left-radius: 2px;
        }

        /* بخش ورودی پیام (بدون آیکون اضافی) */
        .chat-input-area {
            padding: 16px 20px;
            background: #0f172a;
            border-top: 1px solid #1e293b;
            display: flex;
            gap: 12px;
        }

        .chat-input-area input {
            flex: 1;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 14px 18px;
            color: #ffffff;
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s;
        }

        .chat-input-area input:focus {
            border-color: #38bdf8;
        }

        .chat-input-area button {
            background: #2563eb;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            padding: 0 24px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }

        .chat-input-area button:hover {
            background: #1d4ed8;
        }
    </style>
</head>
<body>

<div class="chat-container">
    <div class="chat-header">scrept ai</div>
    
    <div class="chat-messages" id="chatMessages">
        <div class="message bot-message">سلام! من scrept ai هستم. چطور می‌تونم کمکتون کنم؟</div>
    </div>

    <div class="chat-input-area">
        <input type="text" id="userInput" placeholder="پیام خود را به scrept ai بنویسید..." onkeypress="handleKeyPress(event)">
        <button onclick="sendMessage()">ارسال</button>
    </div>
</div>

<script>
    function sendMessage() {
        const input = document.getElementById('userInput');
        const text = input.value.trim();
        if (!text) return;

        // افزودن پیام کاربر
        addMessage(text, 'user-message');
        input.value = '';

        // پاسخ نمونه هوش مصنوعی
        setTimeout(() => {
            if (text.includes("میوه")) {
                addMessage("بفرمایید! این هم چند میوه خوشمزه: 🍎 سیب، 🍌 موز، 🍊 پرتقال.", 'bot-message');
            } else {
                addMessage("پیام شما دریافت شد! چگونه می‌توانم بیشتر به شما کمک کنم؟", 'bot-message');
            }
        }, 600);
    }

    function addMessage(text, className) {
        const container = document.getElementById('chatMessages');
        const div = document.createElement('div');
        div.className = `message ${className}`;
        div.innerText = text;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
    }

    function handleKeyPress(e) {
        if (e.key === 'Enter') {
            sendMessage();
        }
    }
</script>

</body>
</html>
