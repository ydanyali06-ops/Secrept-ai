import json

with open("data.json", "r", encoding="utf-8") as f:
    data = json.load(f)

def chatbot(message):
    message = message.strip()

    for item in data:
        if item["input"] == message:
            return item["output"]

    return "جواب این سؤال را هنوز یاد نگرفته‌ام."

while True:
    message = input("تو: ")

    if message.lower() in ["خروج", "exit", "quit"]:
        print("ربات: خداحافظ!")
        break

    print("ربات:", chatbot(message))
