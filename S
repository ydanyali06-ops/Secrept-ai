<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>scrept ai</title>
    <style>
        body {
            background-color: #111;
            color: #fff;
            font-family: sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .box {
            width: 90%;
            max-width: 600px;
            height: 80vh;
            background: #222;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            padding: 15px;
        }

        .title {
            font-size: 20px;
            font-weight: bold;
            color: #00d2ff;
            margin-bottom: 10px;
        }

        .chat {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .msg {
            padding: 10px;
            border-radius: 8px;
            max-width: 80%;
        }

        .user {
            background: #007bff;
            align-self: flex-start;
        }

        .bot {
            background: #333;
            align-self: flex-end;
        }

        .input-box {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        input {
            flex: 1;
            padding: 10px;
            border-radius: 5px;
            border: none;
            outline: none;
        }

        button {
            padding: 10px 20px;
            background: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>

<div class="box">
    <div class="title">scrept ai</div>
    
    <div class="chat" id="chat">
        <div class="msg bot">سلام! من scrept ai هستم.</div>
    </div>

    <div class="input-box">
        <input type="text" id="text" placeholder="پیام بنویسید...">
        <button onclick="send()">ارسال</button>
    </div>
</div>

<script>
    function send() {
        let input = document.getElementById('text');
        let val = input.value.trim();
        if (val === '') return;

        addMsg(val, 'user');
        input.value = '';

        setTimeout(() => {
            if (val.includes('میوه')) {
                addMsg('🍎 سیب، 🍌 موز، 🍊 پرتقال', 'bot');
            } else if (val.includes('سلام')) {
                addMsg('سلام! چطور کمکت کنم؟', 'bot');
            } else {
                addMsg('دریافت شد: ' + val, 'bot');
            }
        }, 300);
    }

    function addMsg(txt, cls) {
        let chat = document.getElementById('chat');
        let div = document.createElement('div');
        div.className = 'msg ' + cls;
        div.innerText = txt;
        chat.appendChild(div);
        chat.scrollTop = chat.scrollHeight;
    }
</script>

</body>
</html>
